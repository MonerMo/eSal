# Copy this file to .env and fill in real values. .env is gitignored; this file is not.

DATABASE_URL=
JWT_SECRET=
OPENAI_API_KEY=

# Apple Wallet pass signing (see WALLET_PASS_PLAN.md)
PASS_TYPE_IDENTIFIER=
PASS_TEAM_IDENTIFIER=
PASS_SIGNER_PASSPHRASE=
PASS_CERTS_DIR=./certs


#R2 (Cloudflare) object storage for images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=esal-image
R2_PUBLIC_URL=


# Resend (transactional email for OTP verification)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
